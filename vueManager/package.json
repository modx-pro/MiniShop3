{
  "name": "primevue4",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean:vue-dist": "rimraf ../assets/components/minishop3/js/mgr/vue-dist ../assets/components/minishop3/css/mgr/vue-dist",
    "prebuild": "npm run clean:vue-dist",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0",
    "test:smoke": "node --test tests/*.test.js && node scripts/check-ui-group-smoke.mjs",
    "format": "prettier --write \"src/**/*.{js,vue,scss,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,scss,css}\"",
    "lint:all": "npm run lint && npm run format:check && npm run lint:scss",
    "lint:scss": "stylelint \"src/**/*.scss\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:utils": "vitest run src/utils/formatLocalDateYmd.test.js"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "@uppy/core": "^5.1.1",
    "@uppy/dashboard": "^5.0.3",
    "@uppy/drop-target": "^4.0.1",
    "@uppy/image-editor": "^4.0.2",
    "@uppy/xhr-upload": "^5.0.2",
    "pinia": "^3.0.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.1",
    "vue": "^3.5.13",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^9.32.0",
    "happy-dom": "^20.11.2",
    "postcss-prefix-selector": "^2.1.1",
    "prettier": "^3.8.1",
    "rimraf": "^3.0.2",
    "sass-embedded": "^1.85.1",
    "stylelint": "^17.1.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^6.4.2",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vitest": "^3.2.7"
  }
}
