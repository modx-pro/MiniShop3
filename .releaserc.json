{
  "branches": ["beta", "main", "master"],
  "tagFormat": "${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "RELEASES.md",
        "changelogTitle": "# Changelog\n\nВсе значимые изменения. Формат: [Keep a Changelog](https://keepachangelog.com/). Автообновление: semantic-release."
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["RELEASES.md", "package.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
